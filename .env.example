# Copy to .env in the repository root. Never commit .env.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_CHAT_MODEL=gpt-6.1-terra
TYPECAST_API_KEY=
# Must be a real Typecast voice_id beginning with tc_ or uc_.
TYPECAST_VOICE_ID=
DOOBOO_MODEL_PATH=classifier/random_forest_model.joblib
DOOBOO_MAX_UPLOAD_BYTES=20971520
DOOBOO_RATE_LIMIT_REQUESTS=30
DOOBOO_RATE_LIMIT_WINDOW_SECONDS=60
